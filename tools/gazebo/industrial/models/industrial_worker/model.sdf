<?xml version="1.0"?>
<sdf version="1.9">
  <model name="industrial_worker">
    <static>true</static>
    <link name="body">
      <collision name="body_collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><cylinder><radius>0.26</radius><length>1.8</length></cylinder></geometry>
      </collision>
      <visual name="worker_mesh">
        <!-- glTF Y-up -> Gazebo Z-up; assumed glTF +Z front faces drone at -X. Verify on first render. -->
        <pose>0 0 0 1.57079632679 0 -1.57079632679</pose>
        <geometry><mesh><uri>model://industrial_worker/meshes/worker.glb</uri><scale>1 1 1</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
