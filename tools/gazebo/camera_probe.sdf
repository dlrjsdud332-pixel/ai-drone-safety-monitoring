<?xml version="1.0"?>
<sdf version="1.9">
  <world name="camera_probe">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.2 0.3 0.4 1</background></scene>
    <model name="camera"><static>true</static><pose>0 0 1 0 0 0</pose>
      <link name="link"><sensor name="rgb" type="camera">
        <always_on>true</always_on><update_rate>10</update_rate><topic>/safety/probe/image</topic>
        <camera><horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
      </sensor></link>
    </model>
    <model name="target"><static>true</static><pose>3 0 1 0 0 0</pose>
      <link name="link"><visual name="red_box">
        <geometry><box><size>1 1 1</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual></link>
    </model>
  </world>
</sdf>
